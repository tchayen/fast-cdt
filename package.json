{
  "name": "fast-cdt",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run dev:css & bun --hot example/server.ts",
    "dev:css": "bun tailwindcss --watch -i ./example/styles.source.css -o ./example/styles.css",
    "build:css": "bun tailwindcss -i ./example/styles.source.css -o ./example/styles.css",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test",
    "benchmark": "bun run src/benchmark.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-aria-components": "^1.13.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@tailwindcss/cli": "^4.1.14",
    "@types/bun": "latest",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.37.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "eslint-plugin-perfectionist": "^4.15.1",
    "eslint-plugin-unicorn": "^61.0.2",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^16.4.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  }
}
